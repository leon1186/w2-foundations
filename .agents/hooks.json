{
  "deny-rm": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/deny_rm.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "log-commands": {
    "PostToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../scripts/log_command.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
